+    ESP_LOGI(TAG, "EXPERIMENTAL Wi-Fi profile: requested=WIFI_PS_NONE(%d), returned=%s(%d)",
+             (int)WIFI_PS_NONE, returned_ps_name, (int)returned_ps_mode);
