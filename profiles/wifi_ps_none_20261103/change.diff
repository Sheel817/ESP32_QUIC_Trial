+#if DEMO_WIFI_PS_NONE
+    /* Optional experimental profile, shared by QUIC and TCP_TLS. */
+    ESP_ERROR_CHECK(esp_wifi_set_ps(WIFI_PS_NONE));
+    wifi_ps_type_t returned_ps_mode;
